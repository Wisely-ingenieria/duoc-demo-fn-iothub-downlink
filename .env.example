# Copy this file to .env and fill in the values given in class.
# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=curso_duoc
PGUSER=user_curso_duoc
PGPASSWORD=
# Use true on Azure, false for a local database
PGSSL=false
# IoT Hub service connection to send commands to devices
IOTHUB_CONNECTION_STRING=
